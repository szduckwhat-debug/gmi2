--// LÓGICA DE TIRO (INTACTA PARA ATALHOS MAIS CONFIAVEIS)
local function shootRevolver()
	if not loopkillActive or #alvos == 0 then return end
	
	local weapon = getRevolver()
	if not weapon then return end
	
	local currentTime = tick()
	if currentTime - lastShotTime < fireRate then return end
	
	local target = nil
	local attempts = 0
	
	while attempts < #alvos do
		target = alvos[currentTargetIndex]
		
		if target and type(target) == "userdata" and target:IsA("Player") and target.Character then
			local hum = target.Character:FindFirstChildOfClass("Humanoid")
			local hasShield = target.Character:FindFirstChildOfClass("ForceField")
			
			if hum and hum.Health > 0 and not hasShield then
				break
			end
		end
		
		currentTargetIndex = currentTargetIndex + 1
		if currentTargetIndex > #alvos then currentTargetIndex = 1 end
		attempts = attempts + 1
		target = nil
	end
	
	if not target or not target.Character then return end
	
	local char = lp.Character
	if not char then return end
	
	local hum = target.Character:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 or target.Character:FindFirstChildOfClass("ForceField") then return end
	
	local remote = weapon:FindFirstChild("DamageRemote")
	if not remote then return end
	
	local oldParent = weapon.Parent
	if oldParent ~= char then
		weapon.Parent = char
		pcall(function() remote:FireServer(hum) end)
		weapon.Parent = oldParent
	else
		pcall(function() remote:FireServer(hum) end)
	end
	
	lastShotTime = currentTime
end

task.spawn(function()
	while task.wait(0.02) do
		if loopkillActive then
			pcall(shootRevolver)
		end
	end
end)

