-- 5. LANÇAR G2 [MÉTODO DO PC ALTAMENTE MELHORADO!]
createExtraBtn("💣 LANÇAR G2", Color3.fromRGB(255, 0, 0), function()
	local tools = getG2s()
	if #tools == 0 then
		notify("❌ Nenhuma G2 encontrada!", 2)
		return
	end
	
	notify("💣 Lançando todas as G2!", 2)
	task.spawn(function()
		local currentTools = getG2s()
		local conn
		conn = workspace.ChildAdded:Connect(function(child)
			task.spawn(function()
				pcall(function()
					local lowerName = string.lower(child.Name)
					if string.find(lowerName, "grenade") or string.find(lowerName, "g2") or child:IsA("Tool") then
						task.wait()
						
						local function processPart(part)
							if part:IsA("BasePart") then
								part.Velocity = Vector3.new(0, math.min(part.Velocity.Y, 0), 0)
								for _, force in ipairs(part:GetChildren()) do
									if force:IsA("BodyVelocity") or force:IsA("BodyForce") or force:IsA("BodyThrust") or force:IsA("BodyGyro") or force:IsA("BodyPosition") then
										force:Destroy()
									end
								end
							end
						end
						
						if child:IsA("BasePart") then
							processPart(child)
						end
						for _, desc in ipairs(child:GetDescendants()) do
							processPart(desc)
						end
					end
				end)
			end)
		end)

		for i, tool in ipairs(currentTools) do
			task.spawn(function()
				pcall(function()
					if not lp.Character then return end
					local handle = tool:FindFirstChild("Handle")
					if handle and handle:IsA("BasePart") then
						handle.CanCollide = false
					end
					tool.Parent = lp.Character
					tool:Activate()
				end)
			end)
			if i % 5 == 0 then
				task.wait()
			end
		end

		task.delay(2.5, function()
			if conn then conn:Disconnect() end
		end)
		notify("💥 Lançamento finalizado!", 2)
	end)
end)

