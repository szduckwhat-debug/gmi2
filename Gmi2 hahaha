Players.PlayerAdded:Connect(function(player)
	task.wait(0.5)
	if persistentTargets[player.Name] then
		selectedTargets[player] = true
		table.insert(alvos, player)
		notify("⚠️ ALVO RECONECTADO: " .. player.DisplayName, 5)
	end
	updatePlayersList()
end)

Players.PlayerRemoving:Connect(function(player)
	if viewingPlayer == player then resetView() end
	if selectedTargets[player] then
		selectedTargets[player] = nil
		for i, p in ipairs(alvos) do if p == player then table.remove(alvos, i) break end end
	end
	updatePlayersList()
end)

