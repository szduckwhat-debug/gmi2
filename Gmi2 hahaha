createExtraBtn("💣 DUPE G2: OFF", Color3.fromRGB(255, 0, 128), function(btn, stroke)
	dupeG2Active = not dupeG2Active
	if dupeG2Active then
		btn.Text = "💣 DUPE G2: ON"
		btn.TextColor3 = Color3.fromRGB(0, 255, 0)
		stroke.Color = Color3.fromRGB(0, 255, 0)
		notify("💣 Dupe G2 ATIVADO! Colete no chão com Grab All", 2)
		task.spawn(function()
			while dupeG2Active do
				pcall(function()
					local char = lp.Character
					local hrp = char and char:FindFirstChild("HumanoidRootPart")
					local humanoid = char and char:FindFirstChildOfClass("Humanoid")
					if hrp and humanoid then
						if not dupeSpot then
							dupeSpot = hrp.CFrame
						end
						local g2s = getG2s()
						if #g2s > 0 then
							for _, tool in pairs(g2s) do
								pcall(function()
									tool.Parent = workspace
									local handle = tool:FindFirstChild("Handle")
									if handle and handle:IsA("BasePart") then
										handle.CanCollide = true
										handle.Velocity = Vector3.new(0, 0, 0)
										handle.RotVelocity = Vector3.new(0, 0, 0)
										handle.CFrame = dupeSpot + Vector3.new(0, 2, 0)
									end
								end)
							end
							task.wait(0.04)
							humanoid.Health = 0
						end
					end
				end)
				task.wait(1.5)
			end
		end)
