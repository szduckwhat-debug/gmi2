			playerBtn.Size = UDim2.new(1, -5, 0, 52)
			playerBtn.BackgroundColor3 = isSelected and Color3.fromRGB(100, 0, 0) or Color3.fromRGB(10, 0, 0)
			playerBtn.Text = ""
			Instance.new("UICorner", playerBtn).CornerRadius = UDim.new(0, 6)
			
			local Nick = Instance.new("TextLabel", playerBtn)
			Nick.Size = UDim2.new(1, -50, 0, 18)
			Nick.Position = UDim2.new(0, 10, 0, 4)
			Nick.BackgroundTransparency = 1
			Nick.TextColor3 = Color3.fromRGB(255, 255, 0)
			Nick.Text = (isSelected and "🩸 " or "○ ") .. player.DisplayName
			Nick.TextSize = 11
			Nick.Font = Enum.Font.GothamBold
			Nick.TextXAlignment = Enum.TextXAlignment.Left

			local UserLabel = Instance.new("TextLabel", playerBtn)
			UserLabel.Size = UDim2.new(1, -50, 0, 15)
			UserLabel.Position = UDim2.new(0, 25, 0, 20)
			UserLabel.BackgroundTransparency = 1
			UserLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
			UserLabel.Text = "@" .. player.Name
			UserLabel.TextSize = 9
			UserLabel.TextXAlignment = Enum.TextXAlignment.Left

			if isSelected then
				local HealthBG = Instance.new("Frame", playerBtn)
				HealthBG.Size = UDim2.new(0, 55, 0, 4)
				HealthBG.Position = UDim2.new(0, 10, 0, 38)
				HealthBG.BackgroundColor3 = Color3.fromRGB(30, 0, 0)
				HealthBG.BorderSizePixel = 0
				
				local HealthFill = Instance.new("Frame", HealthBG)
				HealthFill.Size = UDim2.new(1, 0, 1, 0)
				HealthFill.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
				HealthFill.BorderSizePixel = 0
				
				local HealthText = Instance.new("TextLabel", playerBtn)
				HealthText.Size = UDim2.new(0, 55, 0, 10)
				HealthText.Position = UDim2.new(0, 10, 0, 42)
				HealthText.BackgroundTransparency = 1
				HealthText.TextColor3 = Color3.fromRGB(255, 255, 255)
				HealthText.TextSize = 7
				HealthText.TextXAlignment = Enum.TextXAlignment.Center
				
				local function updateHealthUI()
					if player.Character and player.Character:FindFirstChildOfClass("Humanoid") then
						local hum = player.Character:FindFirstChildOfClass("Humanoid")
						local health = math.floor(hum.Health)
						local maxHealth = math.floor(hum.MaxHealth)
						local percent = math.clamp(health / maxHealth, 0, 1)
						
						HealthFill.Size = UDim2.new(percent, 0, 1, 0)
						HealthFill.BackgroundColor3 = percent > 0.6 and Color3.fromRGB(0, 255, 0) or percent > 0.3 and Color3.fromRGB(255, 255, 0) or Color3.fromRGB(255, 0, 0)
						HealthText.Text = health .. "/" .. maxHealth
					else
						HealthFill.Size = UDim2.new(0, 0, 1, 0)
						HealthText.Text = "0/0"
					end
				end
				
				updateHealthUI()
				
				local charConn
				local healthConn
				
				local function setupConnections(char)
					if healthConn then healthConn:Disconnect() end
					local hum = char:WaitForChild("Humanoid", 5)
					if hum then
						healthConn = hum.HealthChanged:Connect(updateHealthUI)
						updateHealthUI()
					end
				end
				
				if player.Character then setupConnections(player.Character) end
				charConn = player.CharacterAdded:Connect(setupConnections)
				
				playerBtn.Destroying:Connect(function()
					if charConn then charConn:Disconnect() end
					if healthConn then healthConn:Disconnect() end
				end)
			end

			local ViewBtn = Instance.new("TextButton", playerBtn)
			ViewBtn.Size = UDim2.new(0, 38, 0, 22)
			ViewBtn.Position = UDim2.new(1, -43, 0.5, -11)
			ViewBtn.BackgroundColor3 = Color3.fromRGB(20, 0, 0)
			ViewBtn.Text = "view"
			ViewBtn.TextSize = 9
			ViewBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
			Instance.new("UICorner", ViewBtn).CornerRadius = UDim.new(0, 6)
			
			if viewingPlayer == player then
				local Dot = Instance.new("Frame", ViewBtn)
				Dot.Size = UDim2.new(0, 4, 0, 4)
				Dot.Position = UDim2.new(0, 2, 0.5, -2)
				Dot.BackgroundColor3 = Color3.fromRGB(255, 255, 0)
				Instance.new("UICorner", Dot).CornerRadius = UDim.new(1, 0)
			end

			ViewBtn.MouseButton1Click:Connect(function()
				if viewingPlayer == player then resetView() else
					if player.Character then resetView() viewingPlayer = player applyView(player) end
				end
				updatePlayersList()
			end)

			playerBtn.MouseButton1Click:Connect(function()
				if selectedTargets[player] then
					selectedTargets[player] = nil
					persistentTargets[player.Name] = nil
					for j, p in ipairs(alvos) do if p == player then table.remove(alvos, j) break end end
				else
					selectedTargets[player] = true
					persistentTargets[player.Name] = true
					table.insert(alvos, player)
				end
				updatePlayersList()
			end)
		end
	end
	PlayersList.CanvasSize = UDim2.new(0, 0, 0, (#Players:GetPlayers() * 55))
end

