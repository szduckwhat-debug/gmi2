-- 7. 🎒 DROP ALL & RESET COM RESET PRIMEIRO + CRÔNICA DE DROPAR TUDO INSTANTANEAMENTE NO LUGAR (SEM ESPERAS LENTAS)
createExtraBtn("🎒 DROP ALL & RESET", Color3.fromRGB(255, 128, 0), function()
	pcall(function()
		local char = lp.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local backpack = lp:FindFirstChild("Backpack")
		local humanoid = char and char:FindFirstChildOfClass("Humanoid")
		
		if humanoid and hrp then
			local pos = hrp.CFrame
			local toolsToDrop = {}
			if backpack then
				for _, tool in pairs(backpack:GetChildren()) do
					if tool:IsA("Tool") then
						table.insert(toolsToDrop, tool)
					end
				end
			end
			if char then
				for _, tool in pairs(char:GetChildren()) do
					if tool:IsA("Tool") then
						table.insert(toolsToDrop, tool)
					end
				end
			end
			
			if #toolsToDrop == 0 then
				notify("❌ Nenhum item para dropar!", 2)
				return
			end
			
			-- 1º PASSO: Dropar todos os itens instantaneamente no exato CFrame do jogador com um micro espalhamento ANTES de resetar (Sem cair no Void)
			for _, tool in pairs(toolsToDrop) do
				pcall(function()
					tool.Parent = workspace
					local handle = tool:FindFirstChild("Handle")
					if handle and handle:IsA("BasePart") then
						handle.CanCollide = true
						handle.Velocity = Vector3.new(0, 0, 0)
						handle.RotVelocity = Vector3.new(0, 0, 0)
						handle.CFrame = pos + Vector3.new(math.random(-15, 15)/10, 2 + math.random(-5, 5)/10, math.random(-15, 15)/10)
					end
				end)
			end
			
			task.wait(0.04) -- Um atraso extremamente curto necessário para garantir que o workspace de rede registre os objetos fisicamente fora do Inventário
			
			-- 2º PASSO: Dar Reset no personagem
			humanoid.Health = 0
			notify("🎒 " .. tostring(#toolsToDrop) .. " itens dropados no chão e personagem resetado!", 2)
		else
			notify("❌ Personagem/Humanoid não encontrado!", 2)
		end
	end)
end)

