UserInputService.InputChanged:Connect(function(input)
	if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local mousePos = input.Position.X
		local framePos = SliderFrame.AbsolutePosition.X
		local frameWidth = SliderFrame.AbsoluteSize.X
		local relativeX = math.clamp(mousePos - framePos, 0, frameWidth)
		local percent = relativeX / frameWidth
		
		local minVal = 0.50
		local maxVal = 0.90
		local step = 0.10
		local steps = (maxVal - minVal) / step
		local steppedPercent = math.floor(percent * steps + 0.5) / steps
		local newValue = minVal + steppedPercent * (maxVal - minVal)
		
		SliderKnob.Position = UDim2.new(steppedPercent, -9, 0.5, -9)
		speed1Value = newValue
		if speed1Btn then speed1Btn.Text = string.format("%.2fs", newValue) end
		
		if isUsingDynamic then
			fireRate = newValue
			if SettingsLabel then
				SettingsLabel.Text = "⚙️ VELOCIDADE ATUAL: " .. string.format("%.2fs", newValue) .. "s"
			end
		end
	end
end)

