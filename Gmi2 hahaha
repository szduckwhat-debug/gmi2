		btn.TextColor3 = Color3.fromRGB(255, 0, 128)
		stroke.Color = Color3.fromRGB(255, 255, 255)
		notify("💣 Dupe G2 DESATIVADO!", 2)
		dupeSpot = nil
	end
end)

